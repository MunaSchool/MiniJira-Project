# API — leave empty in local dev (Vite proxies /api and /health to port 3000).
# Production: https://dv69sewi064tv.cloudfront.net
VITE_API_BASE_URL=

# Cognito Hosted UI — VITE_CLIENT_ID must match mini-jira-backend COGNITO_CLIENT_ID
VITE_COGNITO_DOMAIN=https://YOUR_POOL.auth.eu-north-1.amazoncognito.com
VITE_CLIENT_ID=your_app_client_id
VITE_REDIRECT_URI=http://localhost:5174/callback
VITE_LOGOUT_URI=http://localhost:5174/
# Production sign-out: https://dv69sewi064tv.cloudfront.net/login

# Optional: direct password auth (requires USER_PASSWORD_AUTH on app client)
VITE_COGNITO_USER_POOL_ID=eu-north-1_xxxxx
VITE_COGNITO_CLIENT_ID=your_app_client_id
VITE_COGNITO_REGION=eu-north-1

# Team dropdown labels (JSON array). IDs must match DynamoDB teamId values.
VITE_TEAMS=[{"id":"frontend","name":"Frontend"},{"id":"backend","name":"Backend"}]

# Local only: allow login when user missing from DynamoDB
VITE_AUTH_SKIP_PROFILE=false
